# Azure-optimized Dockerfile for Word to PDF Converter
# Optimized for Azure App Service with faster startup

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PORT=8000

# Install system dependencies and LibreOffice
RUN apt-get update && apt-get install -y --no-install-recommends \
    # LibreOffice core components
    libreoffice-core \
    libreoffice-writer \
    libreoffice-common \
    # Essential fonts
    fonts-liberation \
    fonts-dejavu \
    fonts-liberation2 \
    fonts-crosextra-carlito \
    fonts-crosextra-caladea \
    # Font configuration
    fontconfig \
    # Utilities
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    # Rebuild font cache
    && fc-cache -f -v

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p uploads outputs && \
    chmod 755 uploads outputs

# Expose port
EXPOSE 8000

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Use uvicorn with multiple workers for better performance
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--timeout-keep-alive", "75"]
